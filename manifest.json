{
  "manifest_version": 3,
  "name": "About My Professor",
  "version": "1.0",
  "icons": {
    "16": "images/icons/icon16.png",
    "48": "images/icons/icon48.png",
    "128": "images/icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://my.ucsc.edu/*",
    "https://pisa.ucsc.edu/*",
    "https://campusdirectory.ucsc.edu/*",
    "https://www.ratemyprofessors.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://pisa.ucsc.edu/*", "https://my.ucsc.edu/*"],
      "js": ["content.js"],
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["images/*", "prof_research_topics.json", "prof_classes.json"],
      "matches": ["https://pisa.ucsc.edu/*", "https://my.ucsc.edu/*"]
    }
  ]
}
